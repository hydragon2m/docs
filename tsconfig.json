{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "moduleDetection": "force"
  },
  "ts-node": {
    "compilerOptions": {
      "module": "commonjs"
    }
  }
}
